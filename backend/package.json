{
  "name": "pulse-api",
  "version": "1.0.0",
  "private": true,
  "description": "API HTTP et serveur de jeu temps réel de Pulse",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "rimraf dist && tsc",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prisma-migrate.cjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "license": "ISC",
  "type": "commonjs",
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "node-fetch": "^2.7.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node-fetch": "^2.6.13",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "nock": "^14.0.17",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "rimraf": "^6.1.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
