generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Playlist {
  id        String   @id @default(uuid())
  name      String
  ownerId   String 
  createdAt DateTime @default(now())
  
  tracks    Track[]  
}

model Track {
  deezerId   String   @id
  title      String
  artist     String
  coverUrl   String
  previewUrl String

  playlists  Playlist[] 
}